# Copie a .env (o ejecute: python scripts/init_env.py, que genera claves aleatorias).
# Valores de ejemplo. No use secretos reales en el repositorio.

SELLACORREO_PUBLIC_URL=http://localhost:8090

# Claves (mínimo 32 caracteres)
SELLACORREO_SESSION_KEY=dev-sesion-CAMBIAR-000000000000000000000000
SELLACORREO_HMAC_KEY=dev-hmac-destinatario-CAMBIAR-00000000000000

# Modo demostración: muestra en el login la tarjeta «Acceso rápido de demostración».
# Póngalo en false fuera de una demo.
SELLACORREO_DEMO=true
SELLACORREO_DEMO_PASSWORD=Demo2026

# Usuarios del IESS: usuario|Cargo|Unidad|correo|contraseña
# Ingresan con el correo. Si la contraseña va vacía, usan SELLACORREO_DEMO_PASSWORD.
# En la base solo se guarda el hash scrypt de la contraseña.
SELLACORREO_USUARIO_1=iess.comunicacion|Dirección de Comunicación|Comunicación Social|comunicacion@demo.institucion.test|
SELLACORREO_USUARIO_2=iess.afiliacion|Dirección de Afiliación|Afiliación y Cobertura|afiliacion@demo.institucion.test|
SELLACORREO_USUARIO_3=iess.admin|Administración|Subdirección de Tecnología|admin@demo.institucion.test|

# Taxonomías extra (se suman a comunicacional, informativo y recordatorio)
SELLACORREO_TAXONOMIAS=comunicacional,informativo,recordatorio,notificación,campaña
SELLACORREO_INSTITUCION=IESS · entorno de demostración
SELLACORREO_RATE_LIMIT_PER_MIN=30
SELLACORREO_LOGIN_LIMIT_PER_MIN=10
