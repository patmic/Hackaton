{$DOMINIO} {
	# Sin registro de solicitudes: los correos analizados no quedan en ningún log.
	log {
		output discard
	}
	encode gzip

	# API del modelo (protegida con la clave AIESS_CLAVE en llama-server).
	@api path /completion /health /v1/*
	handle @api {
		reverse_proxy ia:8080 {
			# El streaming de la respuesta debe llegar sin esperar al final.
			flush_interval -1
		}
	}

	# La web de AIESS (contenido de app/build/web).
	handle {
		root * /web
		# Cada versión de la web se publica bajo /v<versión>/ (flutter build web --base-href /v<versión>/):
		# son URLs nuevas, así que ningún caché (Cloudflare, navegador) sirve una versión vieja.
		@version path_regexp version ^/v[0-9a-z]+(/.*)$
		rewrite @version {re.version.1}
		try_files {path} /index.html
		# Los archivos de Flutter no cambian de nombre entre versiones: que Cloudflare (o el navegador)
		# siempre pregunte si hay una nueva antes de usar su copia.
		header Cache-Control "no-cache"
		file_server
	}
}
