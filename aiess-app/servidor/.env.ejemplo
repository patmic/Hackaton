# Copia este archivo como .env
# Con dominio (HTTPS automático): DOMINIO=ia.tudominio.com
# Sin dominio (solo IP, http):    DOMINIO=:80
DOMINIO=:80
# Núcleos para el modelo (Ampere A1 gratuita: 4)
HILOS=4
# Clave secreta de la API (la misma que va en secretos.json de la app). No la subas al repo.
AIESS_CLAVE=cambia-esta-clave-larga-y-aleatoria

# Si el servidor ya tiene otro proyecto en 80/443 (deja estos dos y DOMINIO=:80):
# PUERTO_HTTP=8090
# PUERTO_HTTPS=127.0.0.1:8443
# Servidor pequeño (1 núcleo): HILOS=1, PARALELO=1, CONTEXTO=4096
